# Copy to .env and fill in. .env is gitignored — never commit real values.
# How to obtain each of these: docs/07-external-accounts-setup.md

# --- Google OAuth -----------------------------------------------------------
# From the OAuth client you create in Google Cloud (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on that client, exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Database (Turso) -------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Email (Resend), used for login OTPs only -------------------------------
RESEND_API_KEY=
# Sender for login OTPs. A custom domain must be verified in Resend first
# (docs/07-external-accounts-setup.md §3) — until then use onboarding@resend.dev,
# which works with no DNS setup but can only send to your own account's address.
OTP_FROM_ADDRESS=Bee <no-reply@bee.harshitsaini.in>

# --- Crypto -----------------------------------------------------------------
# Encrypts Gmail OAuth tokens at rest. 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every stored token — all accounts will need reconnecting.
TOKEN_ENCRYPTION_KEY=
# Signs session cookies. Generate the same way.
SESSION_SECRET=

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Browser origin allowed to call the API (CORS).
WEB_ORIGIN=http://localhost:5173

# --- Web --------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
